<Window x:Class="DiskPartitioner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:common="clr-namespace:DiskPartitioner.Common"
        mc:Ignorable="d"
        Title="Disk Partitioner for Windows"
        Height="700" Width="1100"
        MinHeight="550" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        FocusManager.FocusedElement="{Binding ElementName=lstDisks}"
        Background="{StaticResource WindowBackgroundBrush}">

    <Window.Resources>
        <!-- Clean Accessible ListBoxItem Style with High Contrast Focus -->
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding SpeechDescription, Mode=OneWay}"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource SelectionBackgroundBrush}"/>
                    <Setter Property="Foreground" Value="{StaticResource SelectionForegroundBrush}"/>
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top Menu & Action Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="6" Margin="0,0,0,10" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <!-- Native Accessible Top Menu (Hidden by default, shown on Alt key) -->
                <Menu x:Name="mainMenu" DockPanel.Dock="Top" Background="{StaticResource SurfaceBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" Padding="6,4" Visibility="Collapsed" IsKeyboardFocusWithinChanged="MainMenu_IsKeyboardFocusWithinChanged" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <MenuItem x:Name="menuFile" Header="_File">
                        <MenuItem Header="_Refresh Disk Topology" InputGestureText="F5" Click="BtnRefresh_Click"/>
                        <Separator/>
                        <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="MenuExit_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="menuDisk" Header="_Disk">
                        <MenuItem Header="_Clean / Wipe Selected Disk..." InputGestureText="C" Click="MenuDiskClean_Click"/>
                        <MenuItem Header="Convert to _GPT" InputGestureText="G" Click="MenuDiskConvertGpt_Click"/>
                        <MenuItem Header="Convert to _MBR" Click="MenuDiskConvertMbr_Click"/>
                        <Separator/>
                        <MenuItem Header="Set _Read-Only" Click="MenuDiskReadOnly_Click"/>
                        <MenuItem Header="Clear Read-_Only" Click="MenuDiskClearReadOnly_Click"/>
                        <MenuItem Header="Take _Offline" Click="MenuDiskOffline_Click"/>
                        <MenuItem Header="Bring _Online" Click="MenuDiskOnline_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="menuPartition" Header="_Partition">
                        <MenuItem Header="_Create New Partition..." InputGestureText="N" Click="MenuPartitionCreate_Click"/>
                        <MenuItem Header="_Format Volume..." InputGestureText="F" Click="MenuPartitionFormat_Click"/>
                        <MenuItem Header="Assign / Change _Drive Letter..." InputGestureText="L" Click="MenuPartitionDriveLetter_Click"/>
                        <MenuItem Header="_Extend Volume..." InputGestureText="E" Click="MenuPartitionExtend_Click"/>
                        <MenuItem Header="_Shrink Volume..." InputGestureText="S" Click="MenuPartitionShrink_Click"/>
                        <Separator/>
                        <MenuItem Header="_Delete Partition" InputGestureText="Del" Click="MenuPartitionDelete_Click"/>
                        <MenuItem Header="_Force Delete Partition Override" InputGestureText="Shift+Del" Click="MenuPartitionForceDelete_Click"/>
                    </MenuItem>
                    <MenuItem x:Name="menuHelp" Header="_Help">
                        <MenuItem Header="_Keyboard Shortcuts" InputGestureText="F1" Click="BtnShortcuts_Click"/>
                        <Separator/>
                        <MenuItem Header="_Check for Updates..." Click="MenuCheckForUpdates_Click"/>
                        <MenuItem Header="_View on GitHub" Click="MenuViewOnGitHub_Click"/>
                        <MenuItem Header="_Create Issue and Report Bug on GitHub" Click="MenuReportIssue_Click"/>
                        <MenuItem Header="_Privacy Policy" Click="MenuPrivacyPolicy_Click"/>
                        <MenuItem Header="_Third-Party Notices and Licenses" Click="MenuThirdPartyNotices_Click"/>
                        <Separator/>
                        <MenuItem Header="_About Disk Partitioner" Click="MenuAbout_Click"/>
                    </MenuItem>
                </Menu>

                <Separator x:Name="menuSeparator" DockPanel.Dock="Top" Background="{StaticResource BorderBrush}" Margin="0,0,0,6" Visibility="Collapsed"/>

                <!-- Header Information & Action Buttons -->
                <DockPanel Margin="12,8,12,8" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="btnRefresh" TabIndex="2" Content="Refresh" Padding="10,5" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Click="BtnRefresh_Click"/>
                    </StackPanel>
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                        <TextBlock Text="Disk Partitioner for Windows" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="txtElevationStatus" Text="Administrator Mode (Full Disk Management Privileges)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </DockPanel>
        </Border>

        <!-- Two-Pane Main Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="300"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*" MinWidth="350"/>
            </Grid.ColumnDefinitions>

            <!-- Left Pane: Physical Disks List -->
            <Border Grid.Column="0" Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="1. Physical Disks" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtDiskCount" Text="(0 disks)" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="lstDisks"
                             Grid.Row="1"
                             TabIndex="0"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Physical Disks"
                             SelectionChanged="LstDisks_SelectionChanged"
                             PreviewKeyDown="LstDisks_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding SpeechDescription}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" CornerRadius="4" AutomationProperties.Name="{Binding SpeechDescription}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                            <Run Text="Style: "/><Run Text="{Binding PartitionStyle, Mode=OneWay}" FontWeight="Medium"/>
                                            <Run Text=" | Bus: "/><Run Text="{Binding BusType, Mode=OneWay}"/>
                                            <Run Text=" | Partitions: "/><Run Text="{Binding PartitionsCount, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Clean / Wipe Disk..." InputGestureText="C" Click="MenuDiskClean_Click"/>
                                            <MenuItem Header="Convert to GPT" InputGestureText="G" Click="MenuDiskConvertGpt_Click"/>
                                            <MenuItem Header="Convert to MBR" Click="MenuDiskConvertMbr_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Set Read-Only" Click="MenuDiskReadOnly_Click"/>
                                            <MenuItem Header="Clear Read-Only" Click="MenuDiskClearReadOnly_Click"/>
                                            <MenuItem Header="Take Offline" Click="MenuDiskOffline_Click"/>
                                            <MenuItem Header="Bring Online" Click="MenuDiskOnline_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Refresh Disk Topology" InputGestureText="F5" Click="BtnRefresh_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Accessible Splitter -->
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"/>

            <!-- Right Pane: Partitions & Volumes List -->
            <Border Grid.Column="2" Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="6" Padding="12" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="txtPartitionsHeader" Text="2. Partitions &amp; Volumes" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtPartitionCount" Text="" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </DockPanel>

                    <ListBox x:Name="lstPartitions"
                             Grid.Row="1"
                             TabIndex="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             AutomationProperties.Name="Partitions and Volumes"
                             SelectionChanged="LstPartitions_SelectionChanged"
                             PreviewKeyDown="LstPartitions_PreviewKeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="AutomationProperties.Name" Value="{Binding SpeechDescription}"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8,6" CornerRadius="4" AutomationProperties.Name="{Binding SpeechDescription}">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                             <RowDefinition Height="Auto"/>
                                             <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock Grid.Row="1" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0">
                                            <Run Text="Offset: "/><Run Text="{Binding StartingOffset, Mode=OneWay, StringFormat={}{0:N0} bytes}"/>
                                            <Run Text=" | Size: "/><Run Text="{Binding FormattedSize, Mode=OneWay}"/>
                                            <Run Text="{Binding FreeSpaceSummary, Mode=OneWay}"/>
                                        </TextBlock>
                                    </Grid>
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Create New Partition..." InputGestureText="N" Click="MenuPartitionCreate_Click"/>
                                            <MenuItem Header="Format Volume..." InputGestureText="F" Click="MenuPartitionFormat_Click"/>
                                            <MenuItem Header="Assign / Change Drive Letter..." InputGestureText="L" Click="MenuPartitionDriveLetter_Click"/>
                                            <MenuItem Header="Extend Volume..." InputGestureText="E" Click="MenuPartitionExtend_Click"/>
                                            <MenuItem Header="Shrink Volume..." InputGestureText="S" Click="MenuPartitionShrink_Click"/>
                                            <Separator/>
                                            <MenuItem Header="Delete Partition" InputGestureText="Del" Click="MenuPartitionDelete_Click"/>
                                            <MenuItem Header="Force Delete Partition Override" InputGestureText="Shift+Del" Click="MenuPartitionForceDelete_Click"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <!-- Status & Polite Screen Reader Live Region -->
        <Border Grid.Row="2" Margin="0,10,0,0" Padding="10,6" Background="{StaticResource SurfaceBackgroundBrush}" CornerRadius="4" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="True">
                    <TextBlock x:Name="txtStatus" Text="Ready" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                    <TextBlock x:Name="txtAnnouncement" 
                               AutomationProperties.LiveSetting="Polite" 
                               AutomationProperties.Name="Screen Reader Announcement"
                               Visibility="Collapsed"/>
                </DockPanel>
                <common:SilentProgressBar Grid.Row="1" x:Name="pbOperation" Height="5" Margin="0,6,0,2"
                                          Background="{StaticResource InputBackgroundBrush}"
                                          Foreground="{StaticResource AccentBrush}"
                                          BorderThickness="0"
                                          Minimum="0" Maximum="100" Value="0"
                                          Visibility="Collapsed"/>
            </Grid>
        </Border>
    </Grid>
</Window>
