<Window x:Class="DiskPartitioner.Views.ResizePartitionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Resize Volume"
        Height="300" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" x:Name="txtTitle" Text="Resize Volume" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,10"/>

            <TextBlock Grid.Row="1" x:Name="txtPartitionInfo" Text="Partition Details" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16"/>

            <StackPanel Grid.Row="2" Margin="0,0,0,12">
                <TextBlock x:Name="lblSizePrompt" Text="Amount of space:" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="txtDeltaValue" Grid.Column="0" Padding="8,6" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" AutomationProperties.Name="Amount of space"/>
                    <ComboBox x:Name="cmbDeltaUnit" Grid.Column="1" Margin="8,0,0,0" Padding="8,6" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" SelectionChanged="CmbDeltaUnit_SelectionChanged" AutomationProperties.Name="Size unit">
                        <ComboBoxItem Content="GB"/>
                        <ComboBoxItem Content="MB"/>
                    </ComboBox>
                </Grid>
                <TextBlock x:Name="txtHint" Text="" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
            </StackPanel>

            <DockPanel Grid.Row="4" LastChildFill="False" Margin="0,16,0,0">
                <Button x:Name="btnApply" Content="Apply" Padding="16,8" DockPanel.Dock="Right" Background="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" Click="BtnApply_Click"/>
                <Button x:Name="btnCancel" Content="Cancel" Padding="16,8" DockPanel.Dock="Right" Margin="0,0,10,0" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" IsCancel="True" Click="BtnCancel_Click"/>
            </DockPanel>
        </Grid>
    </Border>
</Window>
