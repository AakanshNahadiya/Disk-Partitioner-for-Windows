<Window x:Class="DiskPartitioner.Views.UpdateCheckDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Check for Updates"
        Height="300" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBackgroundBrush}">

    <Border Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title -->
            <TextBlock Grid.Row="0" Text="Disk Partitioner for Windows" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>

            <!-- Status Message -->
            <TextBlock Grid.Row="1" x:Name="txtStatus" Text="Checking for updates..." FontSize="14" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,4"/>

            <!-- Version Info -->
            <TextBlock Grid.Row="2" x:Name="txtVersionInfo" Text="" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,12"/>

            <!-- Release Notes Panel (shown when a newer update is available) -->
            <DockPanel Grid.Row="3" x:Name="pnlReleaseNotes" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="txtReleaseNotesHeader" DockPanel.Dock="Top" Text="Release Notes:" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBox x:Name="txtReleaseNotes"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         AcceptsTab="False"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         Background="{StaticResource SurfaceBackgroundBrush}"
                         Foreground="{StaticResource TextPrimaryBrush}"
                         BorderBrush="{StaticResource BorderBrush}"
                         Padding="8"
                         FontSize="12"
                         AutomationProperties.Name="Release Notes"/>
            </DockPanel>

            <!-- Daily Checkbox Setting -->
            <CheckBox Grid.Row="4" x:Name="chkDailyCheck" Content="Automatically check for updates daily" IsChecked="True" FontSize="13" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,4,0,16" Click="ChkDailyCheck_Click"/>

            <!-- Action Buttons -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="btnDownload" Content="Download Update" Padding="14,8" Margin="0,0,10,0" Background="{StaticResource AccentBrush}" Foreground="#FFFFFF" FontWeight="SemiBold" Visibility="Collapsed" Click="BtnDownload_Click"/>
                <Button x:Name="btnViewReleaseNotes" Content="View Release Notes" Padding="14,8" Margin="0,0,10,0" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" Visibility="Collapsed" Click="BtnViewReleaseNotes_Click"/>
                <Button x:Name="btnClose" Content="Close" Padding="16,8" Background="{StaticResource InputBackgroundBrush}" Foreground="{StaticResource TextPrimaryBrush}" BorderBrush="{StaticResource BorderBrush}" IsCancel="True" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
